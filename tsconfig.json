{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src",
    "scripts"
  ],
  "//": "These reach into app, and app spells its imports with a .ts extension under bundler resolution, which NodeNext will not read. tsx runs them anyway.",
  "exclude": [
    "scripts/buildSimTables.ts",
    "scripts/simAgreement.ts"
  ]
}
