node_modules/
data/raw/
dist/
*.log

# a curated file is written aside and moved into place, so a run that
# dies partway through leaves one of these behind
data/curated/*.part

# the leverage count under a weighting other than the shipped one, which
# aggregateLeverage.ts writes when LEVERAGE_SHAPE is set. It is there to
# be measured against the shipped file and then thrown away.
data/curated/leverage-*.csv

# a league pulled from a provider is somebody's private roster, and
# anything under docs is served to the public
docs/data/league-*

# the counting pass, which is named for the play file it read and comes
# back in a couple of seconds from the rows it counted. Thirty three of
# these had been committed by the time anyone looked, at 699 megabytes.
data/kept/counts*.json

# the matchups the live walk works out for one week, from the plays before
# it. The cast tables beside them are committed and stay tracked.
data/kept/matchup-*-before[0-9]*.json

# and the split projection it works out for that week, which comes back
# from the same files the next time the week is walked
data/kept/split-live-*.json

# wrangler's local cache has the Cloudflare account name and where the
# last deploy ran from, and the repo is public
worker/.wrangler/

.claude/worktrees/
.harness/
